# ==============================================================================
# QPay / QtPay Environment & External Provider Configuration Template
# Phase 3A — Integration Adapter Scaffolding
# ==============================================================================
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit live API keys, private keys, or mTLS certificates into git.
# 2. Sensitive provider credentials (mTLS keys, TPP certificates, client secrets) 
#    must NEVER be prefixed with VITE_ (to prevent bundling into browser JS).
# 3. All external integrations are isolated behind Provider Adapters.
# 4. Default mode for all providers is 'mock' until official specs & sandbox access are provisioned.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Phase 1 / 2)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only service role key (Never expose to client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. SARIE IPS / RTP Track (Status: EXTERNAL SPEC REQUIRED)
# ------------------------------------------------------------------------------
# Mode options: mock | sandbox | production
VITE_SARIE_MODE=mock
SARIE_IPS_GATEWAY_URL=
SARIE_PARTICIPANT_BIC=
SARIE_MTLS_CERT=
SARIE_SIGNING_KEY=

# ------------------------------------------------------------------------------
# 3. Nafath / NIC National IAM Track (Status: EXTERNAL SPEC REQUIRED)
# ------------------------------------------------------------------------------
# Mode options: mock | sandbox | production
VITE_NAFATH_MODE=mock
NAFATH_GATEWAY_URL=
NAFATH_SP_ID=
NAFATH_CLIENT_SECRET=
NAFATH_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. SAMA Open Banking Track (Status: EXTERNAL SPEC REQUIRED)
# ------------------------------------------------------------------------------
# Mode options: mock | sandbox | production
VITE_OPEN_BANKING_MODE=mock
OB_GATEWAY_URL=
OB_TPP_CLIENT_ID=
OB_QWAC_CERT=
OB_QSEAL_KEY=

# ------------------------------------------------------------------------------
# 5. Airline NDC / GDS Track (Status: EXTERNAL SPEC REQUIRED)
# ------------------------------------------------------------------------------
# Mode options: mock | sandbox | production
VITE_AIRLINE_GDS_MODE=mock
FLIGHT_GDS_API_URL=
FLIGHT_GDS_API_KEY=
FLIGHT_GDS_OFFICE_ID=

# ------------------------------------------------------------------------------
# 6. Hotel Bed-Bank / GDS Track (Status: EXTERNAL SPEC REQUIRED)
# ------------------------------------------------------------------------------
# Mode options: mock | sandbox | production
VITE_HOTEL_BEDBANK_MODE=mock
HOTEL_API_URL=
HOTEL_API_KEY=
HOTEL_API_SECRET=

# ------------------------------------------------------------------------------
# 7. Airport Services & Chauffeur Track (Status: EXTERNAL SPEC REQUIRED)
# ------------------------------------------------------------------------------
# Mode options: mock | sandbox | production
VITE_AIRPORT_SERVICES_MODE=mock
AIRPORT_SERVICES_API_URL=
AIRPORT_SERVICES_CLIENT_ID=
AIRPORT_SERVICES_SECRET=
